[tencent]
# 腾讯云 API 密钥
secret_id = "AKID**********************"  # 在腾讯云控制台获取
secret_key = "**********************"    # 在腾讯云控制台获取

[deployment]
# 部署区域列表
regions = ["ap-shanghai", "ap-guangzhou", "ap-beijing", "ap-chengdu"]
# 函数配置
function_name = "cloud_proxy_pool_func"
namespace = "default"
runtime = "Python3.9"
time_out = 60

[security]
# 云函数调用鉴权 Token (留空则首次部署时自动生成并回写到 deploy.toml)
auth_token = ""

[health_check]
# 是否部署后立即进行健康检查
enable = true
# 检查的目标 URL
test_url = "http://myip.ipip.net"
# 期望返回的状态码
expected_status = 200
